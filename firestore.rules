rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function isAdmin() { return request.auth != null && exists(/databases/$(db)/documents/admins/$(request.auth.uid)); }
    function role() { return get(/databases/$(db)/documents/admins/$(request.auth.uid)).data.role; }
    function isStaff() { return isAdmin() && role() in ['bendahara','sekretaris']; }

    // Portal publik: hanya data ringkas, bukan KTP/rekening/HP
    match /{col}/{id} {
      allow read: if col in ['publik_anggota','publik_pengurus','publik_ringkasan'];
      allow write: if col in ['publik_anggota','publik_pengurus','publik_ringkasan'] && isStaff();
    }
    // Data tertutup: baca oleh semua pengurus/pengawas, tulis oleh sekretaris & bendahara
    match /{col}/{id} {
      allow read: if isAdmin() && col in ['anggota','simpanan','bku','surat','config','log'];
      allow write: if isStaff() && col in ['anggota','simpanan','bku','surat','config','log'];
    }
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false; // dibuat manual lewat Firebase Console
    }
  }
}
